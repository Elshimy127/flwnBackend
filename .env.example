PORT=8080
DATA_ENGINE_URL=http://127.0.0.1:8002
# Same value as DATA_API_KEY in flwn-data-engine/.env. Server-side only.
DATA_API_KEY=

# Backend-owned auth database (docs/AUTH.md §13). The server connects as flwn_auth_app.
AUTH_DATABASE_URL=postgres://flwn_auth_app:CHANGE_ME@127.0.0.1:5432/flwn_auth?sslmode=disable
# Only for `go run . migrate` (flwn_auth_migrator). Never set this in the server's environment.
# AUTH_MIGRATE_DATABASE_URL=postgres://flwn_auth_migrator:CHANGE_ME@127.0.0.1:5432/flwn_auth?sslmode=disable

# HS256 signing keys, "kid:secret" pairs (each secret >= 32 bytes). Keep the old key listed
# during rotation so tokens signed with it stay valid until they expire.
JWT_KEYS=k1:CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES_xxxxxxxx
JWT_ACTIVE_KID=k1
JWT_ISSUER=flwn-backend
JWT_AUDIENCE=flwn-backend
ACCESS_TTL=15m
REFRESH_IDLE_TTL=168h
SESSION_TTL=720h

# Browser model (docs/AUTH.md §9).
CSRF_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES_yyyyyyyy
FRONTEND_ORIGINS=http://localhost:3000
# false only for local http development; production must be true (HTTPS).
COOKIE_SECURE=false
HSTS=false
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty = trust none.
TRUSTED_PROXIES=
# Base URL used in verification / reset links.
PUBLIC_APP_URL=http://localhost:3000
